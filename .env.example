# =============================================================================
# SERJI — Environment Variables
# Copy values into `.env` or `.env.local` (never commit real secrets).
# =============================================================================

# Supabase (free tier)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# After setting the keys above, run these in the Supabase SQL Editor (in order):
#   1) supabase/migrations/001_initial_schema.sql
#   2) supabase/migrations/002_expense_tracker.sql
# Optional: enable Anonymous Sign-Ins in Auth → Providers for stronger guest IDs.
# Never edit old migrations — add 003_…sql, 004_…sql for new schema changes.

# Google Gemini (free tier) — used by /api/analyze
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Optional override (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
